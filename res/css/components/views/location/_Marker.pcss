.mx_Marker {
    position: relative;
}

.mx_Marker_defaultColor {
    color: $accent;
}

.mx_Marker_border {
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    filter: drop-shadow(0px 3px 5px rgba(0, 0, 0, 0.2));
    background-color: currentColor;

    display: flex;
    justify-content: center;
    align-items: center;

    /* caret down */
    &::before {
        content: "";
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 5px solid currentColor;
        position: absolute;
        bottom: -4px;
    }

    /* small variant for coordinates-area avatar */
    &.mx_Marker_border_small {
        width: 28px;
        height: 28px;

        &::before {
            border-left-width: 3px;
            border-right-width: 3px;
            border-top-width: 3px;
            bottom: -3px;
        }
    }
}

.mx_Marker_icon {
    color: white;
    height: 20px;
}

.mx_Marker_coordinates {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 4px;
    padding: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
}
