.mx_LoginSplashView_container {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: 100vh;
}

.mx_LoginSplashView_content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
    max-width: 500px;
    width: 100%;
    padding: 40px;
    text-align: center;
}

.mx_LoginSplashView_logo {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;

    img {
        max-width: 200px;
        max-height: 200px;
        width: auto;
        height: auto;
        object-fit: contain;
    }
}

.mx_LoginSplashView_spinner {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 16px 0;
}

.mx_LoginSplashView_migrationProgress {
    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;

    .mx_ProgressBar {
        height: 8px;
        width: 600px;

        @mixin ProgressBarBorderRadius 8px;
    }
}

.mx_LoginSplashView_splashButtons {
    text-align: center;
    width: 100%;
    margin-top: 24px;
}

.mx_LoginSplashView_logoutButton {
    min-width: 120px;
}

.mx_LoginSplashView_syncError {
    color: $accent-fg-color;
    background-color: #df2a8b; /* Only used here */
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 32px;
    margin-top: 24px;
    max-width: 100%;
    width: 100%;
    text-align: center;
    box-sizing: border-box;

    h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
    }

    p {
        margin: 0;
        font-size: 14px;
        opacity: 0.9;
        word-wrap: break-word;
    }
}
