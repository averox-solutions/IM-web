.mx_EventTileBubble {
    --EventTileBubble_margin-block: 10px;
 
    background-color: $dark-panel-bg-color;
    padding: 10px;
    border-radius: 20px;
    /* Reserve space for external timestamps, but also cap the width */
    max-width: min(calc(100% - 2 * var(--MessageTimestamp-width)), 600px);
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) min-content min-content;
    /* Make bubble clickable/touch-friendly */
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: rgba(0, 0, 0, 0.1);
 
   
 
    .mx_EventTileBubble_title,
    .mx_EventTileBubble_subtitle {
        grid-column: 2;
        overflow-wrap: break-word;
        min-inline-size: 50px;
        text-align:center;
    }
 
    .mx_EventTileBubble_title {
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-15px;
        grid-row: 1;
text-align:center;
    }
 
    .mx_EventTileBubble_subtitle {
        font-size: $font-12px;
        grid-row: 2;
text-align:center;
 
    }
 
    .mx_MessageTimestamp {
        grid-column: 4;
        grid-row: 1 / 3;
        align-self: center;
        margin-left: $spacing-16;
        margin-top:auto;
        cursor: pointer; /* Make timestamp clickable */
        -webkit-tap-highlight-color: rgba(0, 0, 0, 0.1); /* Visual feedback on tap */
        user-select: none; /* Prevent text selection */
        pointer-events: auto; /* Ensure clicks are captured */
    }
    
    /* Ensure timestamp wrapper doesn't affect layout */
    .mx_EventTileBubble > div[style*="contents"] {
        display: contents !important;
    }
    
    /* Ensure Tooltip wrapper doesn't block clicks on timestamp */
    .mx_EventTileBubble [class*="Tooltip"] {
        pointer-events: none; /* Allow clicks to pass through tooltip wrapper */
    }
    
    .mx_EventTileBubble [class*="Tooltip"] > * {
        pointer-events: auto; /* Re-enable pointer events on timestamp itself */
    }
}