.mx_Marker {
    position: relative;
}

.mx_Marker_defaultColor {
    color: $accent;
}

.mx_Marker_border {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    filter: drop-shadow(0px 3px 5px rgba(0, 0, 0, 0.2));
    background-color: currentColor;

    display: flex;
    justify-content: center;
    align-items: center;

    /* caret down */
    &::before {
        content: "";
        border-left: 5px solid transparent;
        border-right: 5px solid transparent;
        border-top: 5px solid currentColor;
        position: absolute;
        bottom: -4px;
    }
}

.mx_Marker_icon {
    color: white;
    height: 20px;
}

.mx_Marker_coordinates {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    margin-top: 4px;
    padding: 2px 6px;
    font-size: 10px;
    line-height: 1.2;
    white-space: nowrap;
    background: rgba(0, 0, 0, 0.75);
    color: white;
    border-radius: 4px;
    font-family: monospace;
    max-width: 160px;
    overflow: hidden;
    text-overflow: ellipsis;
}
