/* Main container for the homepage */
.mx_HomePage {
    max-width: 960px;
    width: 100%;
    height: 100%;
    margin-left: auto;
    margin-right: auto;
}

/* Default homepage styles */
.mx_HomePage_default {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;

    .mx_HomePage_default_wrapper {
        margin: auto;
    }

    /* Logo image styling */
    img {
        max-width: 100%;  /* Make sure image fits within its container */
        width: 300px;  /* Set a smaller width */
        height: 300px;  /* Set a smaller height */
        cursor: pointer;
        transition: transform 0.3s ease-in-out, box-shadow 0.3s ease;  /* Add box-shadow transition */
        margin-bottom: 10px;
        animation: bounce 3s ease-out infinite; /* Slower bounce with 3s duration */
    }

    h1 {
        font-weight: var(--cpd-font-weight-semibold);
        font-size: 32px;
        line-height: 1.375;
        margin-bottom: 4px;
    }

    h2 {
        margin-top: 4px;
        font-weight: var(--cpd-font-weight-semibold);
        font-size: 18px;
        line-height: 25px;
        color: #6b6b6b;
    }

    .mx_MiniAvatarUploader {
        margin: 0 auto;
        display: none;
    }

    /* Tooltip positioning on left and right of the image */
    .tooltip {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        background: rgb(158 189 234 / 42%);
        color: #616161;
        padding: 10px;
        border-radius: 8px;
        width: 200px;
        text-align: left;
        display: none;
        box-shadow: 0 4px 6px rgba(5, 100, 244, 0.63);
        font-size: 14px;
        line-height: 1.4;
    }

    .tooltip-left {
        left: -220px;
    }

    .tooltip-right {
        right: -220px;
    }

    /* Buttons positioning below the image */
    .mx_HomePage_default_buttons {
        display: flex;
        margin: 60px auto 0;
        width: fit-content;
        justify-content: center;
        visibility: hidden;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    /* Button styling with flexbox to align icon and text */
    .mx_AccessibleButton {
        padding: 10px 33px;
        min-width: 140px;
        height: 48px;
        margin: 20px;
        position: relative;
        display: flex;  /* Use flexbox for layout */
        align-items: center;  /* Align vertically */
        justify-content: center;  /* Align horizontally */
        border-radius: 30px;
        vertical-align: top;
        box-sizing: border-box;

        font-weight: 300;
        font-size: 15px;
        line-height: 20px;
        color: #fff;
        background-color: #323a4f;

        /* Icon inside buttons */
        &::before {
            content: "";
            position: absolute;
            left: 10px;
            width: 30px;
            height: 30px;
            background-color: #fff;
            mask-repeat: no-repeat;
            mask-size: contain;
        }

        &.mx_HomePage_button_sendDm::before {
            mask-image: url("$(res)/img/element-icons/feedback.svg");
        }

        &.mx_HomePage_button_explore::before {
            mask-image: url("$(res)/img/element-icons/roomlist/explore.svg");
        }

        &.mx_HomePage_button_createGroup::before {
            mask-image: url("$(res)/img/element-icons/group-members.svg");
        }

        /* Space the icon and text */
        & > span {
            margin-left: 10px;
        }

        /* Add shimmer animation to buttons */
        background: linear-gradient(135deg,  #000000 , #0dc8c9);
        background-size: 200% 200%;
        animation: bgShift 5s ease infinite, pulseGlow 3s ease-in-out infinite;

        /* Inner shine shimmer */
        &::after {
            content: "";
            position: absolute;
            top: 0;
            left: -75%;
            width: 50%;
            height: 100%;
            background: linear-gradient(120deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.3) 50%, rgba(255, 255, 255, 0) 100%);
            transform: skewX(-20deg);
            animation: shimmer 2.5s infinite;
            border-radius: 30px;
            pointer-events: none;
        }

        &:hover {
            transform: scale(1.07);
            background: linear-gradient(135deg, rgb(10, 161, 161),rgb(35, 35, 35));
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
        }

        /* Optional: smoother icon or text interaction */
        * {
            transition: transform 0.3s ease;
        }

        &:hover * {
            transform: scale(1.03);
        }
    }

    /* Display the buttons and tooltips when hovered */
    .mx_HomePage_default_wrapper:hover .mx_HomePage_default_buttons {
        visibility: visible;
        opacity: 1;
    }

    /* Show the tooltips on hover */
    .mx_HomePage_default_wrapper:hover .tooltip {
        display: block;
    }

    /* Show buttons below the image when hovered */
    .mx_HomePage_default_wrapper:hover .mx_HomePage_default_buttons {
        visibility: visible;
        opacity: 1;
    }
}

/* Bounce animation for the image */
@keyframes bounce {
    0% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-10px);
    }
    100% {
        transform: translateY(0);
    }
}

/* Stop the bounce animation when hovered */
.mx_HomePage_default_wrapper:hover img {
    animation: none; /* Remove the bounce animation when hovered */
}

/* Background gradient animation for the buttons */
@keyframes bgShift {
    0% {
        background-position: 0% 50%;
    }
    50% {
        background-position: 100% 50%;
    }
    100% {
        background-position: 0% 50%;
    }
}

/* Pulse glow animation for the buttons */
@keyframes pulseGlow {
    0%, 100% {
        box-shadow: 0 0 10px rgb(67, 223, 223);
    }
    50% {
        box-shadow: 0 0 20px #0dc8c9;
    }
}

/* Inner shimmer animation for the buttons */
@keyframes shimmer {
    0% {
        left: -75%;
    }
    100% {
        left: 125%;
    }
}
