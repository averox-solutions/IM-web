.mx_AuthHeaderLogo {
    margin-top: 15px;
    flex: 1;
}

.mx_AuthHeaderLogo img {
    width: 100%;
}

@media only screen and (max-width: 480px) {
    .mx_AuthHeaderLogo {
        display: block;
        margin: 20px auto 10px;
        text-align: center;
        max-width: 120px;
    }

    .mx_AuthHeaderLogo img {
        width: 120px;
        height: auto;
    }
}
