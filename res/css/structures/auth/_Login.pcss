.mx_Login_submit {
    @mixin mx_DialogButton;
    font-size: 15px;
    font-weight: var(--cpd-font-weight-semibold);
    width: 100%;
    margin-top: 24px;
    margin-bottom: 24px;
    box-sizing: border-box;
    text-align: center;
    background-color: #488D41;
 
}
 
.mx_Login_submit:disabled {
    opacity: 0.3;
    cursor: default;
}
 
.mx_Login_loader {
    display: inline;
    position: relative;
    top: 2px;
    left: 8px;
}
 
.mx_Login_loader .mx_Spinner {
    display: inline;
}
 
.mx_Login_loader .mx_Spinner img {
    width: 16px;
    height: 16px;
}
 
.mx_Login_error {
    color: $alert;
    font-weight: bold;
    text-align: center;
    margin-top: 12px;
    margin-bottom: 12px;
}
 
.mx_Login_error.mx_Login_serverError {
    text-align: left;
    font-weight: normal;
}
 
.mx_Login_error.mx_Login_serverError.mx_Login_serverErrorNonFatal {
    color: #ff8d13; /* Only used here */
}
 
.mx_Login_type_container {
    display: none;
    align-items: center;
    color: $authpage-primary-color;
 
    .mx_Field {
        margin: 0;
    }
}
 
.mx_Login_type_label {
    flex: 1;
}
 
.mx_Login_underlinedServerName {
    width: max-content;
    border-bottom: 1px dashed $accent;
}
 
div.mx_AccessibleButton_kind_link.mx_Login_forgot {
    display: block;
    margin-top: 24px;
 
    &.mx_AccessibleButton_disabled {
        cursor: not-allowed;
    }
}
 
.mx_Login_spinner {
    display: flex;
    justify-content: center;
    align-items: center;
    align-content: center;
    padding: 14px;
}
 
.mx_Login_fullWidthButton {
    width: 100%;
    margin-bottom: 16px;
}
.mx_Field { position: relative; }
 
/* Mobile responsive styles for login */
@media screen and (max-width: 767px) {
    .mx_Login_submit {
        font-size: 16px;
        padding: 14px;
        min-height: 48px;
    }

    .mx_Login_type_container {
        width: 100%;
        margin-bottom: 16px;
    }

    .mx_Login_type_container .mx_Field {
        width: 100%;
    }

    .mx_Login_type_container select {
        width: 100%;
        font-size: 16px;
        padding: 12px;
    }

    .mx_Login_forgot {
        margin-top: 16px;
        font-size: $font-14px;
    }

    /* 2FA responsive styles */
    .mx_Login_2FA {
        max-width: 100% !important;
        padding: 0 16px 20px 16px !important;
        margin-top: 16px !important;
    }

    .mx_Login_2FA_title {
        font-size: 18px !important;
        margin-top: 0 !important;
        padding-bottom: 16px !important;
    }

    .mx_Login_2FA_input {
        width: 100% !important;
        padding: 14px !important;
        font-size: 18px !important; /* Prevents zoom on iOS */
        min-height: 48px !important;
    }

    .mx_Login_2FA_button {
        width: 100% !important;
        padding: 14px !important;
        font-size: 16px !important;
        min-height: 48px !important;
    }

    .mx_Login_2FA img {
        max-width: 160px !important;
    }
}
 
/* Ensure the input has space for the eye icon */
.mx_Field input[type="password"],
.mx_Field input[type="text"] {
  padding-right: 40px; /* room for the toggle button */
}
.mx_Password_toggle {
  position: absolute;
  right: 8px;
  top: 50%;
  transform: translateY(-50%);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;         /* no extra padding */
  margin: 0;          /* remove margin that pushed it down */
  border: 0;
  background: transparent; /* same background as input shows through */
  cursor: pointer;
  border-radius: 8px; /* keep your nice focus ring shape */
}
 
.mx_Password_toggle:focus-visible {
  outline: 2px solid var(--cpd-color-border-primary);
  outline-offset: 2px;
}