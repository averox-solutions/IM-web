.mx_ContextualMenu_wrapper {
    position: fixed;
    z-index: 5000;
}

.mx_ContextualMenu_background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 1;
}

.mx_ContextualMenu {
    border-radius: 12px;
    border: var(--cpd-border-width-1) solid var(--cpd-color-border-interactive-secondary);
    color: $primary-content;
    position: absolute;
    z-index: 5001;
    width: max-content;
    box-shadow: 0px 4px 24px rgba(0, 0, 0, 0.12);

    /* 🌟 Semi-transparent gradient background: green → white */
    background: linear-gradient(
        135deg,
#bee8ba 0%, /* green with opacity */
        rgba(255, 255, 255, 0.92) 100% /* white with opacity */
    );
    backdrop-filter: blur(8px) saturate(1.1);
    -webkit-backdrop-filter: blur(8px) saturate(1.1);

    /* 🎬 Opening: small delay + fade/slide */
    opacity: 0;
    transform-origin: bottom right;
    animation: menu-fade-in 0.34s ease-out 0.18s forwards;
}

@keyframes menu-fade-in {
    from {
        opacity: 0;
        transform: translateY(12px) scale(0.96);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.mx_ContextualMenu_right {
    right: 16px;
}

.mx_ContextualMenu.mx_ContextualMenu_withChevron_right {
    right: 8px;
}

.mx_ContextualMenu_chevron_right {
    position: absolute;
    right: -8px;
    top: 0px;
    width: 0;
    height: 0;
    border-top: 8px solid transparent;
    border-left: 8px solid rgba(255, 255, 255, 0.92); /* match white end */
    border-bottom: 8px solid transparent;
}

.mx_ContextualMenu_left {
    left: -22;
}

.mx_ContextualMenu.mx_ContextualMenu_withChevron_left {
    left: 8px;
}

.mx_ContextualMenu_chevron_left {
    position: absolute;
    left: -8px;
    top: 0px;
    width: 0;
    height: 0;
    border-top: 8px solid transparent;
    border-right: 8px solid rgba(255, 255, 255, 0.92);
    border-bottom: 8px solid transparent;
}

/* ✅ Open above the Chat button */
.mx_ContextualMenu_top {
    top: -11px;
}

.mx_ContextualMenu.mx_ContextualMenu_withChevron_top {
    top: 8px;
}

.mx_ContextualMenu_chevron_top {
    position: absolute;
    left: 0px;
    top: -8px;
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-bottom: 8px solid rgba(255, 255, 255, 0.92);
    border-right: 8px solid transparent;
}

.mx_ContextualMenu_bottom {
    bottom: 0;
}

.mx_ContextualMenu.mx_ContextualMenu_withChevron_bottom {
    bottom: 8px;
}

.mx_ContextualMenu_chevron_bottom {
    position: absolute;
    left: 0px;
    bottom: -8px;
    width: 0;
    height: 0;
    border-left: 8px solid transparent;
    border-top: 8px solid rgba(255, 255, 255, 0.92);
    border-right: 8px solid transparent;
}

.mx_ContextualMenu_rightAligned {
    transform: translateX(-100%);
}

.mx_ContextualMenu_bottomAligned {
    transform: translateY(-100%);
}

/* ---- Context menu content & options ---- */

.mx_IconizedContextMenu {
    padding: 6px;
    border-radius: 12px;
    backdrop-filter: blur(2px) saturate(1.05);
    -webkit-backdrop-filter: blur(2px) saturate(1.05);
}

/* Staggered reveal for each option (4 buttons) */
.mx_IconizedContextMenuOptionList .mx_IconizedContextMenuOption {
    opacity: 0;
    transform: translateY(6px);
    animation: option-fade 0.22s cubic-bezier(.2,.8,.2,1) forwards;
}

.mx_IconizedContextMenuOptionList .mx_IconizedContextMenuOption:nth-child(1) { animation-delay: .12s; }
.mx_IconizedContextMenuOptionList .mx_IconizedContextMenuOption:nth-child(2) { animation-delay: .16s; }
.mx_IconizedContextMenuOptionList .mx_IconizedContextMenuOption:nth-child(3) { animation-delay: .20s; }
.mx_IconizedContextMenuOptionList .mx_IconizedContextMenuOption:nth-child(4) { animation-delay: .24s; }

@keyframes option-fade {
    to { opacity: 1; transform: translateY(0); }
}

/* Subtle green hover */
.mx_IconizedContextMenuOption {
    border-radius: 10px;
    transition: transform .12s ease, background .12s ease, box-shadow .12s ease;
}
.mx_IconizedContextMenuOption:hover,
.mx_IconizedContextMenuOption:focus-visible {
    background: linear-gradient(
        135deg,
        rgba(72, 141, 65, 0.25) 0%,
        rgba(255, 255, 255, 0.5) 100%
    );
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(0,0,0,.12);
    outline: none;
}
.mx_IconizedContextMenuOption:active {
    background: rgba(22, 163, 74, 0.18);
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(0,0,0,.10);
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
    .mx_ContextualMenu,
    .mx_IconizedContextMenuOptionList .mx_IconizedContextMenuOption {
        animation: none !important;
        transform: none !important;
        transition: none !important;
    }
}

/* Mobile responsive styles */
@media screen and (max-width: 767px) {
    .mx_ContextualMenu {
        max-width: calc(100vw - 32px);
        width: auto;
        min-width: 200px;
    }

    .mx_ContextualMenu_item {
        padding: 14px 16px;
        min-height: 44px;
        font-size: $font-15px;
    }
}
