/* Existing CSS for Room Summary Card */
.mx_RoomSummaryCard {
    --cpd-separator-inset: var(--cpd-space-4x);
    --cpd-separator-spacing: var(--cpd-space-4x);

    .mx_RoomSummaryCard_container {
        text-align: center;
        margin: 20px var(--cpd-space-4x) 0; /* Replaced $spacing-20 with 20px */
    }

    .mx_RoomSummaryCard_roomName,
    .mx_RoomSummaryCard_alias {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        white-space: pre-wrap;
        overflow: hidden;
    }

    .mx_RoomSummaryCard_alias {
        text-overflow: ellipsis;
    }

    /* Start of the Updated Topic Section */
    .mx_RoomSummaryCard_topic {
        color: #317048;
        margin-top: 10px;
        background: #edffed;
        border-radius: 30px;
        padding: 1px 12px;

        .mx_Box {
            width: 100%;
        }

        .mx_RoomSummaryCard_topic_container {
            text-align: start;
            display: flex;
            flex-direction: column; /* Ensures text is stacked */
            justify-content: flex-start; /* First line aligns left */
        }

        .mx_RoomSummaryCard_topic_edit {
            width: max-content;
        }

        p {
            white-space: pre-wrap;
            width: 100%;
            min-width: 0;
            margin: 0;
        }

        a {
            cursor: pointer;
        }

        /* First line fully displayed starting from the left */
        p:first-of-type {
            text-align: left; /* Aligns first line to the left */
            margin: 0;
        }

        /* For the second line, it should be centered under the first line */
        p:last-of-type {
            text-align: center; /* Centers the second line */
            padding-top: 5px;
        }
    }
    /* End of Updated Topic Section */

    .mx_AccessibleButton_kind_link {
        margin-top: 12px;
        margin-bottom: 12px;
        font-size: 13px; /* Replaced $font-13px with 13px */
        font-weight: var(--cpd-font-weight-semibold);
    }
}

/* Existing styles for badges, search, and other UI components */
.mx_RoomSummaryCard_badges {
    margin: var(--cpd-space-4x) 0;
}

.mx_RoomSummaryCard_search {
    flex-grow: 1;
    min-width: 0;

    input[type="search"]::-webkit-search-cancel-button {
        display: unset;
    }
}

.mx_RoomSummaryCard_roomName {
    margin: 12px 0 4px; /* Replaced $spacing-12 with 12px */
}
